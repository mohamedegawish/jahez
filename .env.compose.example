# Copy to `.env` for local `docker compose up --build`.
# On Coolify, paste these into Resources > your stack > Environment Variables instead.
# NEVER commit the real `.env` (it holds passwords + APP_KEY).

# --- generate once: `php artisan key:generate --show` inside jahez_api ---
APP_KEY=base64:PASTE_GENERATED_KEY_HERE

APP_ENV=production
APP_DEBUG=false

# Local defaults (ports mapped in docker-compose.yml).
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- production example (replace with your real domains) ---
# APP_URL=https://api.wezara.example
# CORS_ALLOWED_ORIGINS=https://app.wezara.example
# FRONTEND_URL=https://app.wezara.example
# VITE_API_BASE_URL=https://api.wezara.example/api/v1

# --- database (change both passwords!) ---
DB_DATABASE=jahez
DB_USERNAME=jahez
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-strong-root-password

# --- optional tuning ---
APP_NAME=Jahez
LOG_LEVEL=warning
API_RATE_LIMIT_PER_MINUTE=60
SANCTUM_EXPIRATION=480

# --- mail (default: log only, nothing is delivered) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Jahez
