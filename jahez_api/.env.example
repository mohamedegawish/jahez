APP_NAME=Jahez
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jahez
DB_USERNAME=root
DB_PASSWORD=

# The API is bearer-token only and has no web routes, so sessions are never used (OQ-34).
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local default: messages are written to storage/logs (nothing is delivered).
# Gmail / Google Workspace SMTP (never commit real values):
#   MAIL_MAILER=smtp  MAIL_SCHEME=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587
#   MAIL_USERNAME=<the sending Google account>  MAIL_PASSWORD=<a Google App Password, not the account password>
#   MAIL_FROM_ADDRESS=<the same account or a verified alias>
#   (port 465 instead: MAIL_SCHEME=smtps). Then run `php artisan app:mail-check <address>`.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Jahez API
# Comma-separated exact browser origins allowed by CORS (empty = none).
CORS_ALLOWED_ORIGINS=
# Provisional default; not a measured capacity figure.
API_RATE_LIMIT_PER_MINUTE=60
# Comma-separated proxy/load-balancer IPs or CIDRs in front of the app, or "*" (empty = trust none).
TRUSTED_PROXIES=
# Base URL of the client app; reset/invitation emails link to {FRONTEND_URL}/reset-password.
FRONTEND_URL=http://localhost:3000
# API token lifetime in minutes (blank or 0 falls back to 480).
SANCTUM_EXPIRATION=480

# Business policies (config/jahez.php). Leave unset until the owner decides the
# linked open question (docs/open-questions.md); app:check-production checks them.
# JAHEZ_PROVIDER_REQUIRED_FIELDS=            # OQ-36, e.g. email,phone,sectors
# JAHEZ_DIRECTORY_SHOWS_CONTACT_DETAILS=false # OQ-37
# JAHEZ_PROVIDER_EVALUATION_SCALE_MAX=        # OQ-13
# JAHEZ_PROVIDER_EVALUATION_PASS_MARK=        # OQ-13
# JAHEZ_MARKETPLACE_SINGLE_AWARD=true         # OQ-38
# Invoice issuer, numbering, taxes and fees, payment terms, revenue share and
# contract templates are approved policies in the database (ADR-023), not settings.
# JAHEZ_BUSINESS_TIMEZONE=Africa/Cairo        # calendar of policy effective dates
# JAHEZ_PAYMENT_GATEWAY=                      # OQ-16: no adapter ships yet
# Phase 2 portals (ADR-020)
# JAHEZ_AGREEMENTS_IMC_APPROVAL_REQUIRED=true  # IMC approves an agreement before contract draft / invoice (OQ-17, OQ-43)
# JAHEZ_FACTORY_LEGAL_CHANGES_REVIEWED=true    # recorded factory legal fields change via IMC review (OQ-18)
# JAHEZ_NOTIFICATION_EMAILS=true               # email copies of in-app notifications, through MAIL_* on the queue
# Phase 3 administration (ADR-021)
# JAHEZ_FACTORY_APPROVAL_REQUIRED=true         # only an IMC-approved factory sends service requests (OQ-46)

# Onboarding (ADR-019): private documents disk, upload limits, registrations per IP per hour, factory checklist (OQ-19)
JAHEZ_DOCUMENTS_DISK=local
#JAHEZ_LOGO_MAX_KB=2048
#JAHEZ_LEGAL_DOCUMENT_MAX_KB=5120
#JAHEZ_REGISTRATIONS_PER_HOUR=10
#JAHEZ_FACTORY_REQUIRED_FIELDS=sectors
